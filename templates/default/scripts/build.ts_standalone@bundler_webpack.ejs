import { copyFileSync, existsSync, mkdirSync, rmSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';
import { execSync } from 'node:child_process';
import process from 'node:process';

const prod = process.argv[2] !== 'dev';

if (prod) {
<%- render('compile') -%>
}

if (existsSync('.env')) {
  process.loadEnvFile('.env');
}

const distFolder = prod ? 'dist/build' : 'dist/dev';

if (existsSync(distFolder)) {
  rmSync(distFolder, { recursive: true });
}
mkdirSync(distFolder, { recursive: true });

copyFileSync('manifest.json', join(distFolder, 'manifest.json'));

<%- render('hot-reload') -%>
process.env['DIST_FOLDER'] = distFolder;
// Passed through the child's environment rather than as a `BUILD=production ` command prefix.
// Inline environment assignments are POSIX shell syntax: on Windows cmd.exe they are not a prefix at
// All, and the build died with "'BUILD' is not recognized as an internal or external command".
const env = prod ? { ...process.env, BUILD: 'production' } : process.env;
const watchFlag = prod ? '' : ' --watch';
execSync(`npx webpack --config webpack.config.ts${watchFlag}`, { env, stdio: 'inherit' });

if (!prod) {
  copyToObsidianPluginsFolder(distFolder);
}

function copyToObsidianPluginsFolder(dist: string): void {
  const obsidianConfigFolder = process.env.OBSIDIAN_CONFIG_FOLDER ?? '';
  if (!obsidianConfigFolder) { return; }

  const pluginFolder = join(obsidianConfigFolder, 'plugins', '<%= pluginId %>');
  if (!existsSync(pluginFolder)) {
    mkdirSync(pluginFolder, { recursive: true });
  }
  const { cpSync } = require('node:fs') as typeof import('node:fs');
  cpSync(dist, pluginFolder, { recursive: true });
<%- render({ section: 'reload', indentLevel: 1 }) -%>
}
