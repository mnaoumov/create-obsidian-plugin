      {
        // The developer docs' code blocks, as the docs show them. They are checked under the official sample
        // Plugin's compiler options, which their own `src/docs/tsconfig.json` carries, not under the project's
        // Stricter ones, so they get a ts-loader instance of their own and the rule above leaves them out.
        include: /[\\/]src[\\/]docs[\\/]/,
        test: /\.ts$/,
        use: {
          loader: 'ts-loader',
          options: {
            compilerOptions: {
              noEmit: false,
              rewriteRelativeImportExtensions: true
            },
            configFile: 'src/docs/tsconfig.json',
            instance: 'docs-showcase',
            onlyCompileBundledFiles: true
          }
        }
      },
