
/**
 * The config above, narrowed to the one field this file writes through.
 */
interface ConfigWithProjects {
  test: ProjectsSection;
}

/**
 * The shape of a project entry this file reaches into, which vitest's own union type does not narrow to.
 */
interface JsxProject {
  oxc?: OxcSection;
}

/**
 * The JSX transform a test project is given.
 *
 * Deliberately not named `…Options`: the shared lint config requires every member of a `Params` /
 * `Options` / `Result` interface to be `readonly`, and this one is assigned to.
 */
interface JsxRuntimeSpec {
  importSource: string;
  runtime: string;
}

/**
 * The `oxc` section of a project entry.
 */
interface OxcSection {
  jsx: JsxRuntimeSpec;
}

/**
 * The `test` section of the config above.
 */
interface ProjectsSection {
  projects: JsxProject[];
}

/*
 * Solid compiles its JSX with `babel-preset-solid`, so the project's `tsconfig.json` sets
 * `jsx: 'preserve'` and leaves the JSX in place for the bundler. Vite refuses to parse a file in that
 * state at all -- "make sure to not set jsx to preserve" -- so every suite whose module graph reaches a
 * `.tsx` file fails before it runs. The test projects transform JSX with the automatic runtime instead,
 * from `solid-js/h`, which is the entry point that publishes a `jsx-runtime`; plain `solid-js` does not.
 * Reactivity is not compiled in, which unit tests do not need -- rendering a Solid component is an
 * integration-test job.
 *
 * Applied here rather than through `editContext`, which reaches a project's `test` section only, while
 * `oxc` is a vite-level option on the project itself.
 *
 * Widened through a separate `unknown` binding rather than asserted twice in one expression: the
 * returned type does not overlap `ConfigWithProjects`, so a direct assertion is TS2352, and
 * `as unknown as` in one expression is what the shared lint config bans.
 */
const untypedConfig: unknown = config;
const configWithProjects = untypedConfig as ConfigWithProjects;

for (const project of configWithProjects.test.projects) {
  project.oxc = {
    jsx: {
      importSource: 'solid-js/h',
      runtime: 'automatic'
    }
  };
}
