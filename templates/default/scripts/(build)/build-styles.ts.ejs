import { execSync } from 'node:child_process';

// Tailwind 4 is compiled by its own CLI rather than through PostCSS, because not every bundler this project can
// Use reaches PostCSS on its own. Running the CLI first means every bundler then receives ordinary,
// Already-expanded CSS.
//
// `src/styles/main.css` is the SOURCE (it carries `@import "tailwindcss"`); nothing imports it directly.
// `src/main.ts` imports the generated file below, which is git-ignored.
execSync('npx @tailwindcss/cli --input src/styles/main.css --output src/styles/tailwind.generated.css', { stdio: 'inherit' });