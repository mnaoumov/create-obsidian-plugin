import { builtinModules } from 'node:module';
import { join } from 'node:path';
import process from 'node:process';

import type { Configuration } from 'webpack';

import webpack from 'webpack';
<%- render('import') -%>

const prod = process.env['BUILD'] === 'production';
const distFolder = process.env['DIST_FOLDER'] ?? (prod ? 'dist/build' : 'dist/dev');

const EXTERNAL = [
  'obsidian',
  'electron',
  '@codemirror/autocomplete',
  '@codemirror/collab',
  '@codemirror/commands',
  '@codemirror/language',
  '@codemirror/lint',
  '@codemirror/search',
  '@codemirror/state',
  '@codemirror/view',
  '@lezer/common',
  '@lezer/highlight',
  '@lezer/lr',
  'esbuild',
  'eslint',
  ...builtinModules,
];

export const config: Configuration = {
  entry: './src/main.ts',
  output: {
    path: join(process.cwd(), distFolder),
    filename: 'main.js',
    libraryTarget: 'commonjs2',
    libraryExport: 'default',
  },
  target: 'node',
  mode: prod ? 'production' : 'development',
  devtool: prod ? false : 'inline-source-map',
  externals: Object.fromEntries(
    EXTERNAL.map((mod) => [mod, `commonjs2 ${mod}`]),
  ),
  module: {
    rules: [
      {
        test: /\.tsx?$/,
        // The emitted `tsconfig.json` declares `noEmit: true` and allows `.ts` import specifiers, both
        // Right for the file itself -- more than tsc reads it. ts-loader compiles WITH emit, so it needs
        // Both overridden, and the overrides belong here, in the one tool that needs them, exactly as
        // `jest.config.ts` overrides `rootDir` for the same reason.
        //
        // `rewriteRelativeImportExtensions` rather than turning `allowImportingTsExtensions` off: the
        // Emitted `src/` really does import `./plugin.ts` by that name, so switching it off trades
        // TS5096 for an error on every one of those. This is the option TypeScript added for emitting
        // From exactly such sources. `onlyCompileBundledFiles` keeps ts-loader to the graph webpack
        // Actually pulls in, instead of every file the tsconfig's `include` lists -- it was reaching
        // `webpack.config.ts` and `scripts/dev.ts`, which are no business of the bundle.
        use: {
          loader: 'ts-loader',
          options: {
<%- render('ts-loader-options') -%>
            compilerOptions: {
              noEmit: false,
<%- render('ts-loader-compiler-options') -%>
              rewriteRelativeImportExtensions: true,
            },
            onlyCompileBundledFiles: true,
          },
        },
        exclude: /node_modules/,
      },
<%- render('rule') -%>
    ],
  },
  resolve: {
    extensions: ['.ts', '.tsx', '.js'],
    // The loader above rewrites `./plugin.ts` to `./plugin.js` on emit, but only `./plugin.ts` exists on
    // Disk, and webpack's `extensions` list only appends a suffix to a request that has no extension --
    // It does not map one extension to another. Without this the bundle fails to resolve "./plugin.js".
    extensionAlias: {
      '.js': ['.ts', '.tsx', '.js'],
    },
  },
  plugins: [
    new webpack.BannerPlugin({
      banner: `/*
THIS IS A GENERATED/BUNDLED FILE BY WEBPACK
if you want to view the source, please visit the github repository of this plugin
*/`,
      raw: true,
    }),
<%- render('plugin') -%>
  ],
<%- render('experiments') -%>
};

