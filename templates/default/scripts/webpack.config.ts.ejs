import type { Configuration } from 'webpack';

<%# Sorted as one group: the per-answer partials contribute imports in question-registration order, -%>
<%# which is not the order an import-sorting lint rule wants. See `sortImports` in `src/templates.ts`. -%>
<%- sortImports(`import { builtinModules } from 'node:module';
import { join } from 'node:path';
import process from 'node:process';
// eslint-disable-next-line import-x/no-named-as-default -- The default export IS the \`webpack\` namespace; the same name is the point.
import webpack from 'webpack';
${render('import')}`) -%>

const isProduction = process.env['BUILD'] === 'production';
const distFolder = process.env['DIST_FOLDER'] ?? (isProduction ? 'dist/build' : 'dist/dev');

const EXTERNAL = [
  'obsidian',
  'electron',
  '@codemirror/autocomplete',
  '@codemirror/collab',
  '@codemirror/commands',
  '@codemirror/language',
  '@codemirror/lint',
  '@codemirror/search',
  '@codemirror/state',
  '@codemirror/view',
  '@lezer/common',
  '@lezer/highlight',
  '@lezer/lr',
  'esbuild',
  'eslint',
  ...builtinModules
];

<%# Each per-answer partial ends its entry with a comma so two of them concatenate into a valid list; -%>
<%# the last entry of each array must not carry one. Stripped here rather than by making every partial -%>
<%# know whether it is last. -%>
<%
  const rules = `      {
        // The emitted \`tsconfig.json\` declares \`noEmit: true\` and allows \`.ts\` import specifiers, both
        // Right for the file itself -- more than tsc reads it. ts-loader compiles WITH emit, so it needs
        // Both overridden, and the overrides belong here, in the one tool that needs them, exactly as
        // \`jest.config.ts\` overrides \`rootDir\` for the same reason.
        //
        // \`rewriteRelativeImportExtensions\` rather than turning \`allowImportingTsExtensions\` off: the
        // Emitted \`src/\` really does import \`./plugin.ts\` by that name, so switching it off trades
        // TS5096 for an error on every one of those. This is the option TypeScript added for emitting
        // From exactly such sources. \`onlyCompileBundledFiles\` keeps ts-loader to the graph webpack
        // Actually pulls in, instead of every file the tsconfig's \`include\` lists -- it was reaching
        // \`webpack.config.ts\` and \`scripts/dev.ts\`, which are no business of the bundle.
        exclude: /node_modules/,
        test: /\\.tsx?$/,
        use: {
          loader: 'ts-loader',
          options: {
${render('ts-loader-options')}            compilerOptions: {
              noEmit: false,
${render('ts-loader-compiler-options')}              rewriteRelativeImportExtensions: true
            },
            onlyCompileBundledFiles: true
          }
        }
      },
${render('rule')}`;
  const plugins = `    new webpack.BannerPlugin({
      banner: \`/*
THIS IS A GENERATED/BUNDLED FILE BY WEBPACK
if you want to view the source, please visit the github repository of this plugin
*/\`,
      raw: true
    }),
${render('plugin')}`;
-%>
export const config: Configuration = {
  devtool: isProduction ? false : 'inline-source-map',
  entry: './src/main.ts',
  externals: Object.fromEntries(
    EXTERNAL.map((moduleName) => [moduleName, `commonjs2 ${moduleName}`])
  ),
  mode: isProduction ? 'production' : 'development',
  module: {
    rules: [
<%- rules.replace(/,(?<Trailing>\s*)$/, '$<Trailing>') -%>
    ]
  },
  output: {
    filename: 'main.js',
    libraryExport: 'default',
    libraryTarget: 'commonjs2',
    path: join(process.cwd(), distFolder)
  },
  plugins: [
<%- plugins.replace(/,(?<Trailing>\s*)$/, '$<Trailing>') -%>
  ],
  resolve: {
    // The loader above rewrites `./plugin.ts` to `./plugin.js` on emit, but only `./plugin.ts` exists on
    // Disk, and webpack's `extensions` list only appends a suffix to a request that has no extension --
    // It does not map one extension to another. Without this the bundle fails to resolve "./plugin.js".
    extensionAlias: {
      '.js': ['.ts', '.tsx', '.js']
    },
    extensions: ['.ts', '.tsx', '.js']
  },
  target: 'node'
};
