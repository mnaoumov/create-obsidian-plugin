import { builtinModules } from 'node:module';
import process from 'node:process';

import { defineConfig } from 'vite';
<%- render('import') -%>

const prod = process.env['BUILD'] === 'production';
const distFolder = process.env['DIST_FOLDER'] ?? (prod ? 'dist/build' : 'dist/dev');

const EXTERNAL = [
  'obsidian',
  'electron',
  '@codemirror/autocomplete',
  '@codemirror/collab',
  '@codemirror/commands',
  '@codemirror/language',
  '@codemirror/lint',
  '@codemirror/search',
  '@codemirror/state',
  '@codemirror/view',
  '@lezer/common',
  '@lezer/highlight',
  '@lezer/lr',
  'esbuild',
  'eslint',
  ...builtinModules,
];

export const config = defineConfig({
  plugins: [
<%- render('plugin') -%>
  ],
  build: {
    // An Obsidian release ships `main.js` and `styles.css` and nothing else, so ANY asset vite emits
    // Beside the bundle is a file the plugin will look for and not find once it is installed. Inlining
    // Every one of them is the only shape that survives that: unconditional rather than tied to any
    // Answer, because which assets a `src/` comes to import is not a property of the answers.
    assetsInlineLimit: Number.MAX_SAFE_INTEGER,
    lib: {
      entry: 'src/main.ts',
      formats: ['cjs'],
      fileName: () => 'main.js',
      // Obsidian loads a plugin's stylesheet from `styles.css` and nothing else. Vite's lib mode names
      // The CSS asset after the package by default, so without this the emitted file is
      // `<pluginId>.css` -- shipped, and never read. Vite appends the extension, so the value is the
      // Stem alone.
      cssFileName: 'styles',
    },
    rollupOptions: {
      external: EXTERNAL,
      output: {
        exports: 'default',
        banner: `/*
THIS IS A GENERATED/BUNDLED FILE BY VITE
if you want to view the source, please visit the github repository of this plugin
*/
`,
      },
    },
    sourcemap: prod ? false : 'inline',
    minify: prod,
    outDir: distFolder,
    emptyOutDir: false,
  },
});

