<%# Sorted as one group: the per-answer partials contribute imports in question-registration order, -%>
<%# which is not the order an import-sorting lint rule wants. See `sortImports` in `src/templates.ts`. -%>
<%- sortImports(`import { builtinModules } from 'node:module';
import process from 'node:process';
import { defineConfig } from 'vite';
${render('import')}`) -%>

const isProduction = process.env['BUILD'] === 'production';
const distFolder = process.env['DIST_FOLDER'] ?? (isProduction ? 'dist/build' : 'dist/dev');

const EXTERNAL = [
  'obsidian',
  'electron',
  '@codemirror/autocomplete',
  '@codemirror/collab',
  '@codemirror/commands',
  '@codemirror/language',
  '@codemirror/lint',
  '@codemirror/search',
  '@codemirror/state',
  '@codemirror/view',
  '@lezer/common',
  '@lezer/highlight',
  '@lezer/lr',
  'esbuild',
  'eslint',
  ...builtinModules
];

<%# Each per-answer plugin partial ends its entry with a comma so two of them concatenate into a valid -%>
<%# list; the last entry of the array must not carry one. Stripped here rather than by making every -%>
<%# partial know whether it is last. -%>
<% const plugins = render('plugin'); -%>
export const config = defineConfig({
  build: {
    // An Obsidian release ships `main.js` and `styles.css` and nothing else, so ANY asset vite emits
    // Beside the bundle is a file the plugin will look for and not find once it is installed. Inlining
    // Every one of them is the only shape that survives that: unconditional rather than tied to any
    // Answer, because which assets a `src/` comes to import is not a property of the answers.
    assetsInlineLimit: Number.MAX_SAFE_INTEGER,
<%- render('lint-empty-out-dir') -%>
    emptyOutDir: false,
    lib: {
      // Obsidian loads a plugin's stylesheet from `styles.css` and nothing else. Vite's lib mode names
      // The CSS asset after the package by default, so without this the emitted file is
      // `<pluginId>.css` -- shipped, and never read. Vite appends the extension, so the value is the
      // Stem alone.
      cssFileName: 'styles',
      entry: 'src/main.ts',
      fileName: () => 'main.js',
      formats: ['cjs']
    },
    minify: isProduction,
<%- render('lint-out-dir') -%>
    outDir: distFolder,
    rollupOptions: {
      external: EXTERNAL,
      output: {
        banner: `/*
THIS IS A GENERATED/BUNDLED FILE BY VITE
if you want to view the source, please visit the github repository of this plugin
*/
`,
        exports: 'default',
        // An Obsidian release ships `main.js` and nothing beside it, and lib mode inlines dynamic imports
        // Only for the `umd` and `iife` formats -- under `cjs` each one becomes a sibling chunk that
        // `main.js` then loads by name at runtime.
        inlineDynamicImports: true
      }
    },
    sourcemap: isProduction ? false : 'inline'
  },
  plugins: [
<%- plugins.replace(/,(?<Trailing>\s*)$/, '$<Trailing>') -%>
  ]
});
