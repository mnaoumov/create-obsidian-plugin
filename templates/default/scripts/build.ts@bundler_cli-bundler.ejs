<%# The relative imports go in a group of their own, after a blank line, which is what an import-sorting -%>
<%# lint rule asks for -- and the dev-utils presets now run one. Emitted only when a partial contributes. -%>
<% const relativeImports = render('import'); -%>
import { execSync } from 'node:child_process';
import {
  copyFileSync,
  cpSync,
  existsSync,
  mkdirSync,
  rmSync<%- render('fs-import') %>
} from 'node:fs';
import { join } from 'node:path';
import process from 'node:process';
<%- relativeImports ? `\n${relativeImports}` : '' -%>

<%# `npm run dev` re-enters this script with `dev` in this slot; see `scripts/dev.ts`. -%>
const BUILD_MODE_ARGUMENT_INDEX = 2;
const isProduction = process.argv[BUILD_MODE_ARGUMENT_INDEX] !== 'dev';
<%# The `if (prod)` guard belongs to the partial, not to this wrapper. Wrapping it here emitted an -%>
<%# EMPTY `if (prod) { }` on every answer that contributes no compile step -- which the generated -%>
<%# ESLint config rejects with `no-empty` -- and a nested `if (prod) { if (prod) { … } }` on the one -%>
<%# answer that does. -%>
<%- render('compile') -%>

if (existsSync('.env')) {
  process.loadEnvFile('.env');
}

const distFolder = isProduction ? 'dist/build' : 'dist/dev';

if (existsSync(distFolder)) {
  rmSync(distFolder, { recursive: true });
}
mkdirSync(distFolder, { recursive: true });

copyFileSync('manifest.json', join(distFolder, 'manifest.json'));

<%- render('hot-reload') -%>
process.env['DIST_FOLDER'] = distFolder;
// Passed through the child's environment rather than as a `BUILD=production ` command prefix.
// Inline environment assignments are POSIX shell syntax: on Windows cmd.exe they are not a prefix at
// All, and the build died with "'BUILD' is not recognized as an internal or external command".
const env = isProduction ? { ...process.env, BUILD: 'production' } : process.env;
const watchFlag = isProduction ? '' : ' --watch';
<%- render('run') -%>

if (!isProduction) {
  copyToObsidianPluginsFolder(distFolder);
}

function copyToObsidianPluginsFolder(dist: string): void {
  const obsidianConfigFolder = process.env['OBSIDIAN_CONFIG_FOLDER'] ?? '';
  if (!obsidianConfigFolder) {
    return;
  }

  const pluginFolder = join(obsidianConfigFolder, 'plugins', '<%= pluginId %>');
  if (!existsSync(pluginFolder)) {
    mkdirSync(pluginFolder, { recursive: true });
  }
  cpSync(dist, pluginFolder, { recursive: true });
<%- render({ section: 'reload', indentLevel: 1 }) -%>
}
