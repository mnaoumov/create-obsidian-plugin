<script lang="ts">
  import type { SampleSvelteComponentProps } from './sample-svelte-component.d.ts';

  import { untrack } from 'svelte';

  let { startCount }: SampleSvelteComponentProps = $props();

  // `startCount` seeds the local state once and is deliberately not tracked afterwards. Reading it
  // Directly here would make Svelte warn (`state_referenced_locally`) that only its initial value is
  // Captured -- which is exactly the intent, so `untrack` says so.
  let count = $state(untrack(() => startCount));

  export function increment() {
    count += 1;
  }
</script>

<h4>Sample Svelte Component!</h4>

<div>
  <span>My number is {count}!</span>
</div>

<button onclick={increment}>Increment</button>