import type { SettingDefinitionItem } from 'obsidian';

import { PluginSettingTab } from 'obsidian';

export interface PluginSettings {
  mySetting: string;
}

export const DEFAULT_SETTINGS: PluginSettings = {
  mySetting: 'default'
};

/**
 * The settings tab is declarative: return one definition per row from `getSettingDefinitions()` and Obsidian renders
 * them and indexes them for the settings search. A `control` row's `key` names a property of `plugin.settings`, which
 * `PluginSettingTab` reads and persists itself.
 */
export class <%= pluginShortName %>SettingTab extends PluginSettingTab {
  public override getSettingDefinitions(): SettingDefinitionItem[] {
    return [
      {
        control: {
          key: 'mySetting',
          placeholder: 'Enter your value',
          type: 'text'
        },
        desc: 'Description',
        name: 'Setting #1'
      }
    ];
  }
}
