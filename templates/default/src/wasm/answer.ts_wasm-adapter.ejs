import { instantiateWasmModule } from '@mnaoumov/obsidian-lib/wasm';

import bytes from './module.wasm';

/**
 * The sample module's exports: one function, `answer()`, returning 42.
 */
interface SampleWasmExports extends WebAssembly.Exports {
  readonly answer: () => number;
}

/**
 * Instantiates the sample WebAssembly module and calls its one export.
 *
 * obsidian-dev-toolkit's `wasm` build option inlines the module into `main.js` and makes its import the module's
 * bytes, whichever bundler builds the plugin. obsidian-lib's `instantiateWasmModule` compiles those bytes once, however
 * many times the command runs, and types the exports.
 */
export async function getWasmAnswer(): Promise<number> {
  const { exports } = await instantiateWasmModule<SampleWasmExports>(bytes);
  return exports.answer();
}
