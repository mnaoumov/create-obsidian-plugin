// Parcel resolves a plain `.wasm` import to its own output bundle -- a second file beside `main.js`,
// Which an Obsidian release does not ship. Parcel's `data-url:` scheme inlines the file instead, so the
// Module travels inside the bundle as a `data:` URL.
declare module 'data-url:*' {
  const dataUrl: string;
  // eslint-disable-next-line import-x/no-default-export -- A `.wasm` import is a default import; the declaration has to match.
  export default dataUrl;
}
