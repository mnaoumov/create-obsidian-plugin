import { ItemView } from 'obsidian';
// eslint-disable-next-line import-x/no-deprecated -- Only the third `replaceNode` parameter is deprecated; the two-argument form this file uses is not.
import { render } from 'preact';

import type { SamplePreactComponentProps } from '../preact-components/sample-preact-component.tsx';

import {
  AppContext,
  SamplePreactComponent
} from '../preact-components/sample-preact-component.tsx';

export const SAMPLE_PREACT_VIEW_TYPE = '<%= pluginId %>-SamplePreactView';

export class SamplePreactView extends ItemView {
  public override getDisplayText(): string {
    return 'Sample Preact view';
  }

  public override getViewType(): string {
    return SAMPLE_PREACT_VIEW_TYPE;
  }

  public override onClose(): Promise<void> {
    // eslint-disable-next-line import-x/no-deprecated -- See the import: the two-argument form is not deprecated.
    render(null, this.contentEl);
    return super.onClose();
  }

  public override onOpen(): Promise<void> {
    const START_COUNT = 10;
    const props: SamplePreactComponentProps = {
      startCount: START_COUNT
    };

    // eslint-disable-next-line import-x/no-deprecated -- See the import: the two-argument form is not deprecated.
    render(
      <AppContext.Provider value={this.app}>
        <SamplePreactComponent {...props} />
      </AppContext.Provider>,
      this.contentEl
    );

    return super.onOpen();
  }
}
