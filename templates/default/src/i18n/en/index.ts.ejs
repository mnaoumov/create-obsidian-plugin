import type { BaseTranslation } from 'typesafe-i18n';

<%# `satisfies` rather than an annotation: annotating widens the object to `BaseTranslation`, whose -%>
<%# index signature erases the keys, and `TranslationFunctions<BaseTranslation>` is then indexed by -%>
<%# `string` instead of by the messages this file actually declares. -%>
const en = {
  greeting: 'Hello from <%= pluginName %>!'
} satisfies BaseTranslation;

// eslint-disable-next-line import-x/no-default-export -- typesafe-i18n's generator reads each locale's DEFAULT export.
export default en;
