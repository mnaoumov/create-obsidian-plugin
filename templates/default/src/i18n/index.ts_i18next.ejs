// The named exports are bound to the default instance, the stateful singleton the package documents.
import {
  init,
  t as translate
} from 'i18next';

import en from './locales/en.json';

export async function initI18n(): Promise<void> {
  await init({
    fallbackLng: 'en',
    lng: 'en',
    resources: {
      en: { translation: en }
    }
  });
}

export function t(key: string): string {
  return translate(key);
}
