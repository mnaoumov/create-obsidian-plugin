import i18next from 'i18next';

import en from './locales/en.json';

export async function initI18n(): Promise<void> {
  // eslint-disable-next-line import-x/no-named-as-default-member -- `i18next` is a stateful singleton; the named `init` binds to that same instance and the default is how the package documents it.
  await i18next.init({
    fallbackLng: 'en',
    lng: 'en',
    resources: {
      en: { translation: en }
    }
  });
}

export function t(key: string): string {
  // eslint-disable-next-line import-x/no-named-as-default-member -- See `initI18n` above: the singleton is the API.
  return i18next.t(key);
}
