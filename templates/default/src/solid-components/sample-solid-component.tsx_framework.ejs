import type { App } from 'obsidian';
import type { JSX } from 'solid-js';

import {
  createContext,
  createSignal,
  useContext
} from 'solid-js';

// The view always provides the app, so the context default is never read. Widened through its own
// `unknown` binding rather than asserted twice in one expression: `undefined` does not overlap `App`,
// so a direct assertion is TS2352, and `as unknown as` in one expression is what the shared lint config
// bans.
const UNSET_APP: unknown = undefined;

export const AppContext = createContext<App>(UNSET_APP as App);

export interface SampleSolidComponentProps {
  startCount: number;
}

export function SampleSolidComponent(props: SampleSolidComponentProps): JSX.Element {
  const [count, setCount] = createSignal(props.startCount);
  const app = useContext(AppContext);

  function increment(): void {
    setCount(count() + 1);
  }

  return (
    <>
      <h4>Sample Solid Component!</h4>

      <div>
        <span>
          My number is {count()}
          !
        </span>
      </div>

      <button onClick={increment} type="button">Increment</button>
      <div>
        Vault name: {app.vault.getName()}
      </div>
    </>
  );
}
