{
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "isolatedModules": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUncheckedIndexedAccess": true,
    "strictBindCallApply": true,
    "strictNullChecks": true,
    "useUnknownInCatchVariables": true,
<%- render('compiler-options') -%>
    "lib": [
      "DOM",
      "es2022"
    ],
    "module": "node16",
    "moduleResolution": "node16",
    "noEmit": true,
    "skipLibCheck": true,
    "target": "es2022",
<%# Not optional. With no `types` entry, NOTHING under `node_modules/@types` reaches the program -%>
<%# — measured: zero packages, so every `node:fs` import and every `process` reference in `scripts/` -%>
<%# fails with TS2591 even though `@types/node` is installed. Naming what the project needs is what -%>
<%# the odu config and this generator's own tsconfig both already do. -%>
    "types": [
      "node"<%- render('types') %>
    ],
    "verbatimModuleSyntax": true
  },
  "include": [
    "./*.ts",
<%# `./*.ts` does not match the `.mts` eslint config, and typed lint rules need every file ESLint -%>
<%# reaches to be in this list — `eslint.config.mts` lints itself. Keep in step with `typeScriptFiles`. -%>
    "./eslint.config.*ts",
<%- render('include') -%>
    "./scripts/**/*.ts",
    "src/**/*.ts"<%- render('include-extra') %>
  ]
}
