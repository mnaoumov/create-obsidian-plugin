import eslint from '@eslint/js';
import obsidianmd from 'eslint-plugin-obsidianmd';
import {
  defineConfig,
  globalIgnores
} from 'eslint/config';
import globals from 'globals';
import tseslint from 'typescript-eslint';

const typeScriptFiles = [
  'src/**/*.ts',
  'src/**/*.tsx',
  'scripts/**/*.ts',
  // Root-level config files (`vitest.config.ts`, `commitlint.config.ts`, …). Typed rules need every file
  // ESLint reaches to be in the tsconfig `include`, so these two lists have to agree — and `e2e/` is the
  // Third member whenever an end-to-end runner is chosen. It was in neither list, and the plugin config
  // Below still reached those files: every project with an e2e runner and ESLint died on "You have used
  // A rule which requires type information", the largest single class of install-tier failures.
  '*.ts',
  'eslint.config.mts'<%- render('extra-files') %>
];

export default defineConfig(
  globalIgnores([
    '**/*.cjs',
    '**/*.js',
    '**/*.mjs',
    // The demo scripts show unusual module and `require` styles on purpose; a linter that "fixes" them
    // Breaks the lesson.
    'demo-vault/**',
    'dist/**',
    'main.js'
  ]),
  {
    extends: [
      eslint.configs.recommended,
      ...tseslint.configs.strictTypeChecked,
      ...tseslint.configs.stylisticTypeChecked
    ],
    files: typeScriptFiles,
    languageOptions: {
      globals: {
        ...globals.browser,
        ...globals.node
      },
      parserOptions: {
        ecmaFeatures: {
          jsx: true
        },
        projectService: true,
        tsconfigRootDir: import.meta.dirname
      }
    },
    rules: {
      '@typescript-eslint/explicit-function-return-type': 'error',
      '@typescript-eslint/explicit-member-accessibility': 'error',
      '@typescript-eslint/no-unused-vars': [
        'error',
        {
          args: 'all',
          argsIgnorePattern: '^_',
          caughtErrors: 'all',
          caughtErrorsIgnorePattern: '^_',
          destructuredArrayIgnorePattern: '^_',
          ignoreRestSiblings: true,
          varsIgnorePattern: '^_'
        }
      ],
      '@typescript-eslint/prefer-readonly': 'error',
      'curly': 'error',
      'eqeqeq': 'error',
      'no-console': ['error', { allow: ['warn', 'error'] }],
      'no-var': 'error',
      'prefer-const': 'error',
      'prefer-template': 'error'
    }
  },
  ...obsidianmd.configs.recommended,
  // The Obsidian rules — and the console ban — are about code that SHIPS and runs inside Obsidian: no
  // Node built-ins, because of mobile, and no stray logging. The build scripts are Node by definition
  // And a build script that says what it is doing is behaving correctly, so they are turned back off
  // Outside `src/`. Done as an override rather than by re-scoping the shared config, which would drop
  // The parser settings that come with it.
  {
    files: ['scripts/**/*.ts', '*.ts', 'eslint.config.mts'],
    rules: {
      'no-console': 'off',
      'obsidianmd/no-nodejs-modules': 'off',
      'obsidianmd/rule-custom-message': 'off'
    }
  },
  {
    rules: {
      // `moment` is banned for bundle size, which does not apply here: Obsidian bundles it and
      // Re-exports it, so it is imported from `'obsidian'` and the dependency exists only so
      // `moment.Duration` and friends type-check against the version the app actually runs. A no-op
      // Unless the project depends on it.
      'depend/ban-dependencies': ['error', { allowed: ['moment'] }]
    }
  },
  {
    rules: {
      'obsidianmd/ui/sentence-case': [
        'error',
        {
          brands: [<% _sentenceCaseBrands.forEach((brand, i) => { %>'<%- brand %>'<%= i < _sentenceCaseBrands.length - 1 ? ', ' : '' %><% }); %>]
        }
      ]
    }
  }
);
