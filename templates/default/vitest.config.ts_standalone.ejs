import { defineConfig } from 'vitest/config';

export default defineConfig({
<%- render('jsx') -%>
  resolve: {
    // The `obsidian` npm package is types-only: `"main": ""`, and a published tarball carrying nothing
    // But `.d.ts` files. Vite has to resolve the specifier before `vi.mock` is ever consulted, so the
    // Setup file below is not enough on its own -- without this alias every test that touches the
    // Plugin's own code fails to resolve `obsidian` at all.
    alias: {
      obsidian: 'obsidian-test-mocks/obsidian'
    }
  },
  test: {
    // `obsidian-test-mocks`' `setup()` writes to `Document.prototype`, `Element.prototype` and
    // `window`, none of which exist in the `node` environment.
    environment: 'jsdom',
    globals: true,
    // Without this, vitest's default glob sweeps up `e2e/`, and `npm run test` reports the end-to-end
    // Suite as three failed unit tests -- "browser is not defined" under wdio, and a missing
    // `obsidian` package under obsidian-test. The odu presets escape it because
    // `defineObsidianPluginVitestConfig` gives each of its projects an `include` of its own, and the
    // Jest answer escapes it through `roots: ['<rootDir>/src']`; this config had neither.
    include: ['src/**/*.test.ts'],
    setupFiles: [
      'obsidian-test-mocks/vitest-setup',
      'obsidian-test-mocks/obsidian-typings/vitest-setup'
    ]
  }
});
