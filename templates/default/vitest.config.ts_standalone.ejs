    // Setup file below is not enough on its own -- without this alias every test that touches the
    // Plugin's own code fails to resolve `obsidian` at all.
    alias: {
      obsidian: 'obsidian-test-mocks/obsidian'
    }
  },
  test: {
    // `obsidian-test-mocks`' `setup()` writes to `Document.prototype`, `Element.prototype` and
    // `window`, none of which exist in the `node` environment.
    environment: 'jsdom',
    globals: true,
    setupFiles: [
      'obsidian-test-mocks/vitest-setup',
      'obsidian-test-mocks/obsidian-typings/vitest-setup'
    ]
  }
});
