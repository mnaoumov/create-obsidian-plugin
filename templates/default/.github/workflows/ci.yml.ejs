name: CI

on:
  push:
    branches: [<%= defaultBranch %>]
  pull_request:
    branches: [<%= defaultBranch %>]

jobs:
  ci:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-node@v7
        with:
          node-version: 24
          cache: npm
      - run: npm ci
<%- render('steps') -%>
      - run: npm run build
